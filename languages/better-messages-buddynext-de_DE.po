msgctxt "Error when starting a conversation without a relation"
msgid "You can write to %s once you follow each other or are connected."
msgstr "Du kannst %s schreiben, sobald ihr euch folgt oder verbunden seid."

msgctxt "Message when a reply is blocked without a relation"
msgid "You can send messages once you follow each other or are connected."
msgstr "Du kannst Nachrichten senden, sobald ihr euch folgt oder verbunden seid."

msgctxt "Error when starting a conversation with a blocked member"
msgid "You cannot send messages to %s."
msgstr "Du kannst %s keine Nachrichten senden."

msgctxt "Message when a reply is blocked because of a block"
msgid "You cannot send messages in this conversation."
msgstr "Du kannst in dieser Unterhaltung keine Nachrichten senden."

msgctxt "Error when a guest tries to start a conversation"
msgid "Please sign in to send messages."
msgstr "Bitte melde dich an, um Nachrichten zu senden."
